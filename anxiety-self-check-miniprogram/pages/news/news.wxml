<view class="page">
  <view class="intro-card">
    <text class="title">心理健康资讯</text>
    <text class="body">来源：中国新闻网健康 RSS，点击查看原文。</text>
    <text wx:if="{{source === 'cache'}}" class="status">当前展示最近一次成功获取的公开资讯。</text>
  </view>
  <view wx:if="{{loading}}" class="state">正在加载资讯…</view>
  <view wx:elif="{{error}}" class="state">
    <text>{{error}}</text>
    <button class="retry" bindtap="retry">重新加载</button>
  </view>
  <view wx:else class="news-list">
    <view wx:for="{{items}}" wx:key="url" class="news-item" data-url="{{item.url}}" bindtap="openArticle">
      <text class="news-title">{{item.title}}</text>
      <text class="news-date">{{item.publishedAt}}</text>
      <text class="news-link">点击查看原文</text>
    </view>
  </view>
</view>
