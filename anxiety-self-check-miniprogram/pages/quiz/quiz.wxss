.progress {
  display: block;
  color: #0f766e;
  font-size: 28rpx;
  margin-bottom: 24rpx;
}

.question {
  display: block;
  color: #4b5563;
  font-size: 28rpx;
  margin-top: 24rpx;
}

.prompt {
  display: block;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.45;
  margin: 24rpx 0 32rpx;
}

.option {
  border: 2rpx solid #d1d5db;
  border-radius: 16rpx;
  margin: 16rpx 0;
  padding: 28rpx;
}

.selected {
  background: #ccfbf1;
  border-color: #0f766e;
}
